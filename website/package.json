{
    "name": "ayon-docs",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "docusaurus": "docusaurus",
        "prestart": "node -e \"require('fs').mkdirSync('graphql',{recursive:true})\" && docusaurus graphql-to-doc --force && node scripts/graphql-version.js",
        "start": "docusaurus start",
        "prebuild": "node -e \"require('fs').mkdirSync('graphql',{recursive:true})\" && docusaurus graphql-to-doc --force && node scripts/graphql-version.js",
        "build": "docusaurus build",
        "swizzle": "docusaurus swizzle",
        "deploy": "docusaurus deploy",
        "clear": "docusaurus clear",
        "serve": "docusaurus serve",
        "write-translations": "docusaurus write-translations",
        "write-heading-ids": "docusaurus write-heading-ids",
        "ci": "yarn lint && yarn format:diff",
        "lint": "eslint --cache \"**/*.js\" && stylelint \"**/*.css\"",
        "format": "prettier --config .prettierrc --write \"**/*.{js,jsx,ts,tsx,md,mdx}\"",
        "format:diff": "prettier --config .prettierrc --list-different \"**/*.{js,jsx,ts,tsx,md,mdx}\""
    },
    "dependencies": {
        "@docusaurus/core": "2.4.0",
        "@docusaurus/plugin-client-redirects": "2.4.0",
        "@docusaurus/plugin-ideal-image": "^2.4.0",
        "@docusaurus/preset-classic": "2.4.0",
        "@docusaurus/theme-mermaid": "2.4.0",
        "@easyops-cn/docusaurus-search-local": "0.35.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource-variable/jost": "^5.3.0",
        "@graphql-markdown/diff": "1.1.9",
        "@graphql-markdown/docusaurus": "1.26.4",
        "@graphql-markdown/helpers": "1.0.8",
        "@graphql-markdown/printer-legacy": "1.9.1",
        "@graphql-tools/graphql-file-loader": "8.0.8",
        "@mdx-js/react": "^1.6.22",
        "add": "^2.0.6",
        "clsx": "^1.2.1",
        "colorthief": "^2.4.0",
        "docusaurus-plugin-sass": "^0.2.3",
        "graphql": "^16.9.0",
        "graphql-config": "5.1.3",
        "prism-react-renderer": "^1.3.5",
        "react": "^17.0.2",
        "react-dom": "^17.0.2",
        "react-markdown": "^8.0.7",
        "redocusaurus": "^1.6.1",
        "sass": "^1.60.0",
        "yarn": "^1.22.19"
    },
    "devDependencies": {
        "@babel/eslint-parser": "^7.18.2",
        "@docusaurus/module-type-aliases": "2.4.0",
        "docusaurus": "^1.14.7",
        "prettier": "^2.7.1"
    },
    "browserslist": {
        "production": [
            ">0.5%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "engines": {
        "node": ">=16.14"
    },
    "resolutions": {
        "cytoscape": "3.23.0",
        "@graphql-markdown/core": "1.12.2",
        "@graphql-markdown/utils": "1.7.1",
        "@graphql-markdown/logger": "1.0.5",
        "@graphql-markdown/graphql": "1.1.5",
        "@graphql-markdown/printer-legacy": "1.9.1",
        "@graphql-markdown/helpers": "1.0.8",
        "@graphql-markdown/diff": "1.1.9",
        "graphql-config": "5.1.3",
        "@graphql-tools/graphql-file-loader": "8.0.8",
        "@graphql-tools/utils": "10.6.4",
        "@graphql-tools/load": "8.0.9",
        "@graphql-tools/merge": "9.0.14",
        "@graphql-tools/schema": "10.0.13",
        "@graphql-tools/import": "7.0.8",
        "@graphql-tools/json-file-loader": "8.0.8",
        "@graphql-tools/url-loader": "8.0.20",
        "@graphql-tools/code-file-loader": "8.1.10",
        "@graphql-tools/graphql-tag-pluck": "8.3.9",
        "@graphql-tools/executor": "1.3.9",
        "@graphql-tools/delegate": "10.2.8",
        "@graphql-tools/wrap": "10.0.26",
        "@graphql-tools/batch-execute": "9.0.10",
        "@graphql-markdown/printer-legacy/@docusaurus/utils": "2.4.0"
    }
}
